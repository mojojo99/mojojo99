# ── Claude API ────────────────────────────────────────────────────────────────
# Get one at https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Your business ─────────────────────────────────────────────────────────────
COMPANY_NAME=Your Training Company Pte Ltd
COMPANY_EMAIL=sales@yourcompany.com
COMPANY_PHONE=+65 1234 5678
COMPANY_ADDRESS=123 Business Park, Singapore 123456
COMPANY_WEBSITE=https://yourcompany.com
CURRENCY=SGD

# Public URL where this server is reachable (needed for PDF download links
# and the WhatsApp webhook). e.g. https://bot.yourcompany.com
PUBLIC_BASE_URL=http://localhost:8000

# ── Safety / autonomy ─────────────────────────────────────────────────────────
# draft  = invoices/proposals & email replies are saved for human approval
# auto   = bot sends replies and documents directly to clients
EMAIL_MODE=draft
INVOICE_MODE=draft

# ── WhatsApp (Meta WhatsApp Business Cloud API) ──────────────────────────────
# From https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; used once when registering the webhook
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# ── Email (IMAP to read, SMTP to send) ───────────────────────────────────────
# For Gmail: enable 2FA, then create an App Password:
#   https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=sales@yourcompany.com
EMAIL_PASSWORD=your-app-password
# How often (seconds) to check for new client emails
EMAIL_POLL_SECONDS=120
